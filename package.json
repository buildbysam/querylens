{
  "name": "querylens",
  "type": "module",
  "scripts": {
    "dev:hono": "tsx watch src/index.ts",
    "dev": "concurrently \"tsx watch src/index.ts\" \"tailwindcss -i ./src/global.css -o ./public/css/styles.css --watch\"",
    "build": "dotenv run -f .env -- node scripts/build.js",
    "start": "dotenv run -f .env -- node dist/index.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "^4.13.14",
    "hono-rate-limiter": "^0.5.4",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.6",
    "drizzle-kit": "1.0.0-rc.5",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=22"
  }
}
