NODE_ENV=development
APP_ORIGIN=https://yourdomain.com
PORT=8000

# database
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DB_NAME

# cookies
COOKIES_SECRET=replace-with-openssl-rand-base64-48

# jwt
JWT_ACCESS_SECRET=replace-with-openssl-rand-base64-48
JWT_REFRESH_SECRET=replace-with-openssl-rand-base64-48

# logs
LOG_LEVEL=info
LOG_FILE_PATH=logs