NODE_ENV=development
APP_ORIGIN=https://yourdomain.com
PORT=8000

# database
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DB_NAME

# cookies
COOKIES_SECRET=replace-with-openssl-rand-base64-48

# jwt
JWT_ACCESS_SECRET=replace-with-openssl-rand-base64-48
JWT_REFRESH_SECRET=replace-with-openssl-rand-base64-48

# monitored-database credentials are encrypted with this key 
ENCRYPTION_KEY=replace-with-openssl-rand-base64-48

# collector
COLLECTION_INTERVAL_SECONDS=60

# logs
LOG_LEVEL=info
# must be an absolute path when set; defaults to ./logs
# LOG_FILE_PATH=/var/log/querylens

# docker compose (used by compose.yaml; DATABASE_URL above is ignored in compose)
POSTGRES_USER=querylens
POSTGRES_PASSWORD=
POSTGRES_DB=querylens
HOST_PORT=8000
