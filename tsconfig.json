{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "rootDir": ".",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@modules/*": ["./src/modules/*"],
      "@lib/*": ["./src/shared/lib/*"],
      "@db/*": ["./src/shared/db/*"],
      "@views/*": ["./src/shared/views/*"],
      "@middleware/*": ["./src/shared/middleware/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "scripts/*.ts", "drizzle.config.ts"],
  "exclude": ["node_modules"]
}
